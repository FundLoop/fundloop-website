{
  "name": "fundloop-website",
  "version": "0.1.2",
  "description": "FundLoop website and application built with Next.js, React, TypeScript, and Supabase.",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/FundLoop/fundloop-website",
  "repository": {
    "type": "git",
    "url": "https://github.com/FundLoop/fundloop-website.git"
  },
  "bugs": {
    "url": "https://github.com/FundLoop/fundloop-website/issues"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "@cubid/api": "file:vendor/cubid/cubid-api-0.1.0.tgz",
      "@cubid/web2": "file:vendor/cubid/cubid-web2-0.1.0.tgz",
      "@cubid/web2-react": "file:vendor/cubid/cubid-web2-react-0.1.0.tgz"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test --project=remote-safe",
    "test:e2e:remote": "playwright test --project=remote-safe",
    "test:e2e:local": "node scripts/run-playwright-local-wallet.mjs",
    "test:e2e:personas": "node scripts/run-playwright-local-personas.mjs",
    "test:e2e:feature-118": "node scripts/run-feature-118-operational-matrix.mjs",
    "test:e2e:hosted-operational": "playwright test --project=hosted-operational",
    "mcp:dev": "pnpm --filter @fundloop/mcp-server dev",
    "mcp:test": "pnpm --filter @fundloop/mcp-server test",
    "mcp:smoke": "pnpm --filter @fundloop/mcp-server smoke",
    "mcp:edge:smoke": "node scripts/smoke-mcp-edge-http.mjs",
    "mcp:inspect": "pnpm --filter @fundloop/mcp-server inspect",
    "mcp:registry:check": "node scripts/validate-mcp-server-json.mjs",
    "mcp:publish": "pnpm --filter @fundloop/mcp-server publish:metadata",
    "supabase:replay:pr": "node scripts/run-supabase-pr-replay.mjs",
    "supabase:replay:failure-smoke": "node scripts/smoke-supabase-pr-replay-failure.mjs",
    "supabase:replay:ci": "node scripts/run-supabase-pr-replay-ci.mjs",
    "test:db": "node scripts/run-database-test-suite.mjs",
    "supabase:functions:serve:project-payment-drafts-create": "supabase functions serve project-payment-drafts-create --env-file .env.local",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@cubid/api": "file:vendor/cubid/cubid-api-0.1.0.tgz",
    "@cubid/core": "0.1.0",
    "@cubid/web2": "file:vendor/cubid/cubid-web2-0.1.0.tgz",
    "@cubid/web2-react": "file:vendor/cubid/cubid-web2-react-0.1.0.tgz",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.99.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "viem": "^2.48.1",
    "wagmi": "^3.6.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.3",
    "typescript": "5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  }
}
