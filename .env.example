# Supabase local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cubid
CUBID_DAPP_ID=
CUBID_API_KEY=
CUBID_API_BASE_URL=https://passport.cubid.me/api/v2
CUBID_STAMP_PAGE_ID=
# Cubid cross-app access (#266). The issuer signs identity assertions and security event tokens.
CUBID_OIDC_ISSUER=
# Only when the issuer does not serve its keys at {issuer}/jwks.
CUBID_OIDC_JWKS_URI=
# The resource audience from the Cubid pairing, which an assertion's `aud` must equal.
FUNDLOOP_CROSS_APP_AUDIENCE=
# FundLoop's own client id at Cubid. A security event token's `aud` must equal it, and Sign in with
# Cubid authenticates as it. A different value from the resource audience above, and the same Cubid
# client for both roles on purpose: Cubid derives the pairwise subject from the client id.
FUNDLOOP_CUBID_CLIENT_ID=
# Sign in with Cubid (#275). The secret Cubid issued for the client above, and the redirect URI
# registered there, matched exactly.
CUBID_OIDC_CLIENT_SECRET=
FUNDLOOP_CUBID_REDIRECT_URI=
# Only when the issuer does not serve these at {issuer}/authorize and {issuer}/token.
CUBID_OIDC_AUTHORIZATION_ENDPOINT=
CUBID_OIDC_TOKEN_ENDPOINT=

# Fundloop internal
FUNDLOOP_DEPLOYMENT_ENV=local
FUNDLOOP_PAYMENTS_CRON_SECRET=
FUNDLOOP_BASE_INTAKE_SECRET=
BASE_INTAKE_RPC_URL=
BASE_INTAKE_REPLACEMENT_RESOLVER_URL=
BASE_INTAKE_REPLACEMENT_RESOLVER_SECRET=
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_PRIVATE_KEY=
FUNDLOOP_LOCAL_BASE_FIXTURE_MODE=false
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
FUNDLOOP_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_STRIPE_CONNECT_REVIEW_ENABLED=false
FUNDLOOP_INTERNAL_ADMIN_EMAILS=
FUNDLOOP_ZKAS_SUPERADMIN_EMAILS=

# Playwright
PLAYWRIGHT_REMOTE_BASE_URL=
PLAYWRIGHT_REMOTE_SUPABASE_URL=
PLAYWRIGHT_REMOTE_SUPABASE_SERVICE_ROLE_KEY=
PLAYWRIGHT_REMOTE_ALLOW_CANONICAL_SUPABASE=false
PLAYWRIGHT_LOCAL_BASE_URL=http://127.0.0.1:3001
PLAYWRIGHT_LOCAL_RPC_URL=http://127.0.0.1:8545
PLAYWRIGHT_LOCAL_CHAIN_ID=8453
PLAYWRIGHT_LOCAL_WALLET_ADDRESS=
NEXT_PUBLIC_FUNDLOOP_E2E_LOCAL_WALLET=false
NEXT_PUBLIC_FUNDLOOP_LOCAL_WALLET_MANIFEST_JSON=

# Chains
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_ETHEREUM_INTAKE_CONTRACT=
NEXT_PUBLIC_BASE_INTAKE_CONTRACT=
NEXT_PUBLIC_CELO_INTAKE_CONTRACT=
NEXT_PUBLIC_ETHEREUM_TREASURY_ADDRESS=
NEXT_PUBLIC_BASE_TREASURY_ADDRESS=
NEXT_PUBLIC_CELO_TREASURY_ADDRESS=

# End-to-end
FUNDLOOP_E2E_ENABLED=false
FUNDLOOP_E2E_SECRET=
